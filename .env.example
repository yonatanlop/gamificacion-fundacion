# ---------------------------------------------------------------------------
# Gamificación Fundación — variables de entorno
# Copia este archivo a .env y ajusta los valores antes de "docker compose up".
# ---------------------------------------------------------------------------

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=kahoot
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=kahoot

# URL que usa el servidor para conectarse a la base (host = nombre del servicio docker)
DATABASE_URL=postgresql://kahoot:cambia-esta-clave@db:5432/kahoot?schema=public

# --- Servidor / API ---
# Secreto para firmar los JWT. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=2h

# Directorio (dentro del contenedor) donde se guardan las imágenes subidas.
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=5

# Origen permitido para CORS. En producción pon el dominio real, p.ej. https://gamificacion.midominio.org
# Para desarrollo con Vite: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# URL pública base (se usa para construir el link de juego que ve el admin).
PUBLIC_BASE_URL=http://localhost:8080

# --- Primer administrador (creado por el seed) ---
SEED_ADMIN_EMAIL=admin@fundacion.org
SEED_ADMIN_PASSWORD=cambia-esta-clave-admin
SEED_ADMIN_NAME=Administrador

# --- Puerto expuesto por el reverse proxy (nginx) ---
WEB_PORT=8080

# --- HTTPS con Caddy (solo si usas docker-compose.prod.yml) ---
# Dominio que apunta a la IP pública. Gratis con sslip.io: <ip-con-guiones>.sslip.io
CADDY_DOMAIN=

# --- Cliente (build de Vite) ---
# Base de la API vista desde el navegador. Vacío = mismo origen (a través de nginx).
VITE_API_BASE=
